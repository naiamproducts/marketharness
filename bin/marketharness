#!/usr/bin/env bash
# marketharness — hermetic launcher for the marketharness V1 distribution.
#
# marketharness is a marketing-team distribution of OpenCode V1 ONLY: it ships
# its own pinned runtime (opencode-ai@1.19.3 in its own npm prefix), its own
# XDG dirs under ~/.config/marketharness, and its own rendered profile config.
# It NEVER reads or writes an existing OpenCode install (~/.config/opencode,
# ~/.local/share/opencode*, ~/.opencode, credentials, sessions) and NEVER
# execs a system `opencode` binary — the only OpenCode binary it runs is the
# pinned runtime under its install root.
#
# Usage:
#   marketharness [dir]         open the V1 TUI (optionally in a workspace or
#                              project dir — V1 discovers project files from cwd)
#   marketharness init-workspace <dir> [--company slug] [--project slug]
#                              scaffold the workspace tree (SPEC §5)
#   marketharness update        re-run the installer in --update mode
#   marketharness help          show this help
#   marketharness --version     product version + runtime pin + config paths +
#                              qloo state + engram/aven state
#   marketharness --stage-only  force a re-render of the profile config into
#                              the config home (used by install.sh)
#   anything else              passed through verbatim to the pinned runtime
#                              (agent list, models, debug config, debug skill,
#                              run, serve, session, ...)
#
# Optional local tools (SPEC §7b): engram (persistent memory, MCP) and aven
# (local-first tasks) are single product-private binaries under
# $MARKETHARNESS_ROOT/tools/bin. Their PATH entry takes precedence over any
# user install. aven's DB is pinned to the caller's REAL state home (captured
# before the XDG redirect) and is intentionally shared across projects.
#
# Environment:
#   MARKETHARNESS_HOME  config home (default: $HOME/.config/marketharness)
#   MARKETHARNESS_ROOT  install root — runtime + installed repo copy
#                      (default: $HOME/.local/share/marketharness)
#   AVEN_DB            aven SQLite DB. Default: the caller's
#                      ${XDG_STATE_HOME:-$HOME/.local/state}/aven/db.sqlite
#                      (never the hermetic state dir). Set it to use another DB.
#   QLOO_API_KEY       optional server-style auth: passed through to the MCP
#                      child when present. It is NOT required — the canonical
#                      entry {"command":"qloo","args":["mcp"]} carries no key
#                      of its own; the mcp.qloo entry is gated by the `qloo`
#                      CLI on PATH plus a credential (this variable OR the
#                      harness's own private config from `qloo setup --qloo`)
#                      and is REMOVED from the render otherwise.
set -euo pipefail

# --- Locate this script (through symlinks) ---------------------------------
SOURCE="${BASH_SOURCE[0]}"
while [[ -L "$SOURCE" ]]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
BIN_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
REPO_ROOT="$(cd "$BIN_DIR/.." && pwd)"   # launcher's own repo: profile/, skills/, install.sh

# --- Product / runtime identity --------------------------------------------
PRODUCT_VERSION="0.1.0"
OPENCODE_PIN="1.19.3"

# --- Hermetic layout (SPEC §1) ---------------------------------------------
MARKETHARNESS_HOME="${MARKETHARNESS_HOME:-$HOME/.config/marketharness}"
MARKETHARNESS_ROOT="${MARKETHARNESS_ROOT:-$HOME/.local/share/marketharness}"
CONFIG_DIR="$MARKETHARNESS_HOME/opencode"                  # XDG_CONFIG_HOME/opencode
OPENCODE_CONFIG="$CONFIG_DIR/opencode.json"
RUNTIME_BIN="$MARKETHARNESS_ROOT/opencode/node_modules/.bin/opencode"

# The caller's REAL state home, captured BEFORE the XDG redirect below (SPEC
# §7b). aven resolves its SQLite DB under XDG state, so redirecting first
# would bury every product task in a private DB the user never sees. A
# caller-set AVEN_DB always wins (custom boards stay possible).
REAL_XDG_STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"
AVEN_DB="${AVEN_DB:-$REAL_XDG_STATE_HOME/aven/db.sqlite}"

# Product-private optional tools (SPEC §7b). Prepending them to PATH means a
# pre-existing engram/aven on the user's PATH is never read or used by this
# product, while agents' `aven ...` / `engram ...` calls resolve here.
TOOLS_BIN="$MARKETHARNESS_ROOT/tools/bin"
ENGRAM_BIN="$TOOLS_BIN/engram"
if [[ -d "$TOOLS_BIN" ]]; then
  PATH="$TOOLS_BIN:$PATH"
fi

# Where the rendered skills path points: the repo that owns THIS launcher when
# it carries a skills/ tree (installed copy or dev checkout), else the install root.
if [[ -d "$REPO_ROOT/skills" ]]; then
  SKILLS_ROOT="$REPO_ROOT"
else
  SKILLS_ROOT="$MARKETHARNESS_ROOT"
fi

# --- Presentation -----------------------------------------------------------
INDIGO=$'\033[38;5;105m'
MUTED=$'\033[38;5;245m'
BOLD=$'\033[1m'
RED=$'\033[38;5;203m'
RESET=$'\033[0m'

die() { printf '%smarketharness:%s %s\n' "$RED" "$RESET" "$*" >&2; exit 1; }

# --- Qloo gate (SPEC §7) -----------------------------------------------------
# Canonical MCP entry: {"command":"qloo","args":["mcp"]} — the credential NEVER
# appears in any config file. It lives in the harness's own private config
# (`qloo setup --qloo`) or in QLOO_API_KEY on the environment (server-style
# auth, passed through to the MCP child right before exec).
QLOO_MIN_VERSION="0.1.26"
QLOO_GATE_FILE="$MARKETHARNESS_HOME/.qloo-gate"
QLOO_TOKEN=""       # "qloo" -> render the mcp.qloo entry; "" -> omit it
QLOO_CREDENTIAL=""  # environment | harness | missing | unknown
QLOO_VERSION=""     # installed harness version ("" when unknown / not probed)
QLOO_GATE_CHANGED=0

# Cheap, stat-only fingerprint recomputed on EVERY launch. It moves exactly
# when the credential state can move: the CLI appearing/disappearing,
# QLOO_API_KEY being (un)set, or the harness's own config file being written.
# Probing `qloo setup --status` costs seconds, so it runs only when this moves.
qloo_gate_fingerprint() {
  local bin=absent key=absent cfg=none cfg_file
  if command -v qloo >/dev/null 2>&1; then bin=present; fi
  if [[ -n "${QLOO_API_KEY:-}" ]]; then key=present; fi
  cfg_file="${QLOO_HOME:-$HOME/.qloo}/config"
  if [[ -f "$cfg_file" ]]; then
    cfg="$(stat -c %Y "$cfg_file" 2>/dev/null || printf 'none')"
  fi
  printf 'bin=%s,key=%s,cfg=%s' "$bin" "$key" "$cfg"
}

qloo_gate_field() {
  local key="$1" line
  [[ -f "$QLOO_GATE_FILE" ]] || return 0
  while IFS= read -r line; do
    case "$line" in
      "$key="*) printf '%s' "${line#*=}"; return 0 ;;
    esac
  done < "$QLOO_GATE_FILE"
}

# Credential probe. `qloo setup --status --json` is NON-INTERACTIVE by
# construction (verified against @qloo/qloo-harness 0.1.26): --status forces
# interactive:false, interactive setup refuses to run without a TTY
# ("qloo setup: interactive setup requires a TTY. Use qloo setup --status
# --json for automation."), and it makes no Qloo network call — it reads the
# harness config plus local auth files only.
# Prints: environment | harness | missing | unknown
qloo_credential_state() {
  local out parsed
  if [[ -n "${QLOO_API_KEY:-}" ]]; then printf 'environment'; return 0; fi
  if ! command -v qloo >/dev/null 2>&1; then printf 'missing'; return 0; fi
  if command -v timeout >/dev/null 2>&1; then
    out="$(timeout 25 qloo setup --status --json </dev/null 2>/dev/null || true)"
  else
    out="$(qloo setup --status --json </dev/null 2>/dev/null || true)"
  fi
  if [[ -z "$out" ]]; then printf 'unknown'; return 0; fi
  parsed="$(printf '%s' "$out" | python3 -c '
import json, sys
try:
    report = json.load(sys.stdin)
    print("harness" if (report.get("qloo") or {}).get("ready") else "missing")
except Exception:
    print("unknown")
' 2>/dev/null)" || parsed="unknown"
  printf '%s' "${parsed:-unknown}"
}

# Warn — never fail — on an old harness (the official kit needs >= 0.1.26).
# Echoes a message, or nothing when the version is acceptable/unknown.
qloo_version_note() {
  local ver="$1" lowest
  [[ "$ver" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || return 0
  lowest="$(printf '%s\n%s\n' "$QLOO_MIN_VERSION" "$ver" | sort -V | head -1)"
  if [[ "$lowest" != "$QLOO_MIN_VERSION" ]]; then
    printf 'qloo %s is older than the recommended %s — update with: npm install --global @qloo/qloo-harness (Node >= 22.19 is required to install the harness itself)' \
      "$ver" "$QLOO_MIN_VERSION"
  fi
}

# Refresh the gate, then decide whether mcp.qloo is rendered in. The probe runs
# only when the fingerprint moved or staging is forced; any probe failure falls
# back to RENDERING the entry, so the harness itself returns its clear auth
# error instead of Qloo silently disappearing from the product.
qloo_refresh_gate() {
  local force_probe="${1:-0}" fp cached_fp cached_cred cached_ver note tmp
  fp="$(qloo_gate_fingerprint)"
  cached_fp="$(qloo_gate_field fingerprint)"
  cached_cred="$(qloo_gate_field credential)"
  cached_ver="$(qloo_gate_field version)"

  if [[ "$force_probe" == "1" || -z "$cached_fp" || "$cached_fp" != "$fp" || -z "$cached_cred" ]]; then
    QLOO_CREDENTIAL="$(qloo_credential_state)"
    QLOO_VERSION=""
    if command -v qloo >/dev/null 2>&1; then
      QLOO_VERSION="$(qloo --version 2>/dev/null | head -1 | tr -d '[:space:]' || true)"
    fi
    mkdir -p "$MARKETHARNESS_HOME"
    tmp="$QLOO_GATE_FILE.tmp.$$"
    {
      printf 'fingerprint=%s\n' "$fp"
      printf 'credential=%s\n' "$QLOO_CREDENTIAL"
      printf 'version=%s\n' "$QLOO_VERSION"
    } > "$tmp"
    mv "$tmp" "$QLOO_GATE_FILE"
    QLOO_GATE_CHANGED=1
    note="$(qloo_version_note "$QLOO_VERSION")"
    if [[ -n "$note" ]]; then
      printf '%smarketharness: warning:%s %s\n' "$RED" "$RESET" "$note" >&2
    fi
  else
    QLOO_CREDENTIAL="$cached_cred"
    QLOO_VERSION="$cached_ver"
    QLOO_GATE_CHANGED=0
  fi

  case "$QLOO_CREDENTIAL" in
    missing) QLOO_TOKEN="" ;;                        # CLI absent or no credential
    *)       QLOO_TOKEN="qloo" ;;                    # environment | harness | unknown
  esac
}

qloo_state() {
  local fp cached_fp cred ver note
  fp="$(qloo_gate_fingerprint)"
  cached_fp="$(qloo_gate_field fingerprint)"
  cred="$(qloo_gate_field credential)"
  ver="$(qloo_gate_field version)"
  if [[ -z "$cred" ]]; then
    if command -v qloo >/dev/null 2>&1; then
      printf 'not probed yet (run: marketharness --stage-only)'
    else
      printf 'not installed (optional — mcp.qloo omitted from the render)'
    fi
    return 0
  fi
  if [[ "$cached_fp" != "$fp" ]]; then
    printf 'stale (environment changed — run: marketharness --stage-only), last decision: '
  fi
  case "$cred" in
    environment) printf 'active (canonical qloo mcp; credential: QLOO_API_KEY env)' ;;
    harness)     printf 'active (canonical qloo mcp; credential: qloo setup --qloo)' ;;
    unknown)     printf 'active (credential state unknown — the harness returns its own auth error)' ;;
    missing)
      if command -v qloo >/dev/null 2>&1; then
        printf 'installed but no credential — mcp.qloo omitted (run: qloo setup --qloo, then marketharness --stage-only)'
      else
        printf 'not installed (optional — mcp.qloo omitted; npm install --global @qloo/qloo-harness)'
      fi
      ;;
    *) printf '%s' "$cred" ;;
  esac
  note="$(qloo_version_note "$ver")"
  if [[ -n "$note" ]]; then printf ' — %s' "$note"; fi
}

# --- Optional tools state (SPEC §7b) ----------------------------------------
# engram (memory) and aven (tasks) are optional product-private binaries.
# Missing tools never block a launch: the mcp.engram entry is removed from the
# render and agents state the degradation in one line.
engram_available() {
  [[ -x "$ENGRAM_BIN" ]] && "$ENGRAM_BIN" --version >/dev/null 2>&1
}

engram_state() {
  if engram_available; then
    printf 'active (%s; mcp.engram rendered: %s mcp)' \
      "$("$ENGRAM_BIN" --version 2>/dev/null | head -1)" "$ENGRAM_BIN"
  else
    printf 'not installed (optional — mcp.engram omitted from the render)'
  fi
}

aven_state() {
  local bin ver
  bin="$(command -v aven 2>/dev/null || true)"
  if [[ -z "$bin" ]]; then
    printf 'not installed (optional — delegations are tracked only when aven is present)'
    return 0
  fi
  ver="$("$bin" --version 2>/dev/null | head -1)"
  printf '%s (%s) — tasks go to %s' "${ver:-aven}" "$bin" "$AVEN_DB"
}

# --- Profile staging (first run + source-newer-than-stamp) ------------------
# Renders profile/ into the config home with python3 (atomic writes):
#   __MARKETHARNESS_ROOT__   -> repo whose skills/ dir is shipped
#   __MARKETHARNESS_CONFIG__ -> rendered config dir (tui-plugins/ + themes/)
#   __QLOO_MCP__             -> the canonical `qloo` command token when the gate
#                              allows it, else the whole mcp.qloo entry is
#                              removed from the JSON (SPEC §7). Producer and
#                              consumer are this same render: any surviving
#                              placeholder aborts the launch below.
#   __ENGRAM_BIN__           -> absolute product-private engram binary when it
#                              exists, else the mcp.engram entry is removed
#                              (SPEC §7b).
# Never clobbers a staged file that differs from the incoming render without
# backing it up first as <file>.bak.<timestamp>.
stage_profile() {
  local force="${1:-0}"   # 1 = --stage-only (ignore the freshness stamp)
  local profile_src="$REPO_ROOT/profile"
  [[ -f "$profile_src/opencode.json" ]] \
    || die "no profile source at $profile_src (re-install: bash $REPO_ROOT/install.sh)"
  command -v python3 >/dev/null 2>&1 \
    || die "python3 not found — it is required to render the profile config"

  # Qloo gate (SPEC §7): refresh the cached decision first, so a changed
  # credential state (harness installed/configured after the last stage)
  # forces a re-render even when the profile source itself is unchanged.
  qloo_refresh_gate "$force"
  if [[ "$QLOO_GATE_CHANGED" == "1" ]]; then force=1; fi

  local stamp="$MARKETHARNESS_HOME/.profile-stamp"
  if [[ "$force" != "1" && -f "$stamp" && -f "$OPENCODE_CONFIG" ]] \
     && [[ -z "$(find "$profile_src" -type f -newer "$stamp" -print -quit)" ]]; then
    return 0   # staged copy is current
  fi

  mkdir -p "$CONFIG_DIR"
  local out engram_token=""
  if engram_available; then engram_token="$ENGRAM_BIN"; fi
  if ! out="$(python3 - "$profile_src" "$CONFIG_DIR" "$SKILLS_ROOT" \
                     "$QLOO_TOKEN" "$engram_token" "$stamp" <<'PY'
import json, os, re, shutil, sys, tempfile, time

profile_src, config_dir, skills_root, qloo, engram, stamp = sys.argv[1:7]
# `qloo` is the canonical command token (SPEC §7): the entry renders as
# {"type":"local","command":["qloo","mcp"]} and never carries a credential.
# `engram` is the absolute product-private binary (SPEC §7b).
qloo = qloo or None
engram = engram or None
SUBS = {
    "__MARKETHARNESS_ROOT__": skills_root,
    "__MARKETHARNESS_CONFIG__": config_dir,
}
if engram:
    SUBS["__ENGRAM_BIN__"] = engram
PLACEHOLDER = re.compile(r"__[A-Z][A-Z0-9_]*__")
ts = time.strftime("%Y%m%d%H%M%S")
first_run = 0 if os.path.exists(stamp) else 1


def substitute_strings(node):
    if isinstance(node, dict):
        return {k: substitute_strings(v) for k, v in node.items()}
    if isinstance(node, list):
        return [substitute_strings(v) for v in node]
    if isinstance(node, str):
        for key, val in SUBS.items():
            node = node.replace(key, val)
        if "__QLOO_MCP__" in node:
            if qloo:
                node = node.replace("__QLOO_MCP__", qloo)
        return node
    return node


changed = backups = removed_qloo = removed_engram = 0
errors = []
for root, _dirs, files in os.walk(profile_src):
    for name in sorted(files):
        src = os.path.join(root, name)
        rel = os.path.relpath(src, profile_src)
        with open(src, encoding="utf-8") as f:
            raw = f.read()

        if name.endswith(".json"):
            try:
                data = substitute_strings(json.loads(raw))
            except ValueError as exc:
                errors.append(f"{rel}: not valid JSON in source ({exc})")
                continue
            # MCP gates (SPEC §7, §7b): an entry is present ONLY when its gate
            # allowed it. mcp["qloo-docs"] (credential-free docs MCP) is never
            # touched. Without the token the entry is removed so the render
            # stays valid and placeholder-free.
            mcp = data.get("mcp")
            if isinstance(mcp, dict):
                if "__QLOO_MCP__" in json.dumps(data) and not qloo:
                    if "qloo" in mcp:
                        del mcp["qloo"]
                        removed_qloo = 1
                if "__ENGRAM_BIN__" in json.dumps(data) and not engram:
                    if "engram" in mcp:
                        del mcp["engram"]
                        removed_engram = 1
            out = json.dumps(data, indent=2, ensure_ascii=False) + "\n"
        else:
            out = raw
            for key, val in SUBS.items():
                out = out.replace(key, val)
            if "__QLOO_MCP__" in out and qloo:
                out = out.replace("__QLOO_MCP__", qloo)

        leftover = sorted(set(PLACEHOLDER.findall(out)))
        if leftover:
            errors.append(f"{rel}: placeholder(s) not substituted: {', '.join(leftover)}")
            continue

        dst = os.path.join(config_dir, rel)
        os.makedirs(os.path.dirname(dst), exist_ok=True)
        existing = None
        if os.path.exists(dst):
            with open(dst, encoding="utf-8") as f:
                existing = f.read()
        if existing == out:
            continue
        if existing is not None:
            # Local edit or older render: never clobber without a backup.
            shutil.copy2(dst, dst + ".bak." + ts)
            backups += 1
            print(f"backed up: {dst}.bak.{ts}", file=sys.stderr)
        fd, tmp = tempfile.mkstemp(dir=os.path.dirname(dst), prefix=".stage-")
        try:
            with os.fdopen(fd, "w", encoding="utf-8") as f:
                f.write(out)
            os.replace(tmp, dst)
        finally:
            if os.path.exists(tmp):
                os.unlink(tmp)
        changed += 1

if errors:
    for e in errors:
        print(f"staging error: {e}", file=sys.stderr)
    sys.exit(1)

print(f"first={first_run} changed={changed} backups={backups} qloo_removed={removed_qloo} engram_removed={removed_engram}")
PY
  )"; then
    die "profile staging failed (see errors above); refusing to launch with a broken config"
  fi

  touch "$stamp"

  local stage_first=0 stage_changed=0 stage_backups=0
  [[ "$out" =~ first=([01]) ]] && stage_first="${BASH_REMATCH[1]}"
  [[ "$out" =~ changed=([0-9]+) ]] && stage_changed="${BASH_REMATCH[1]}"
  [[ "$out" =~ backups=([0-9]+) ]] && stage_backups="${BASH_REMATCH[1]}"
  if [[ "$stage_changed" != "0" ]]; then
    printf '%smarketharness:%s profile staged into %s (%s file(s)%s)\n' \
      "$INDIGO" "$RESET" "$CONFIG_DIR" "$stage_changed" \
      "$([[ "$stage_backups" != "0" ]] && printf ', %s backup(s)' "$stage_backups")"
  fi

  # Fail loudly if ANY placeholder survived the render — a leftover would
  # silently break skills discovery, the theme/logo plugin, or qloo/engram
  # wiring.
  local leftovers
  leftovers="$(grep -RIl '__MARKETHARNESS_ROOT__\|__MARKETHARNESS_CONFIG__\|__QLOO_MCP__\|__ENGRAM_BIN__' \
                 "$CONFIG_DIR" 2>/dev/null || true)"
  [[ -z "$leftovers" ]] \
    || die "placeholder(s) survived staging in: $(printf '%s ' $leftovers)
Re-stage with: marketharness --stage-only (or re-run ./install.sh)"

  STAGE_FIRST="$stage_first"
}

# --- First-launch next steps (SPEC §9) --------------------------------------
maybe_first_launch_banner() {
  local marker="$MARKETHARNESS_HOME/.first-launch-done"
  [[ -f "$marker" ]] && return 0
  mkdir -p "$MARKETHARNESS_HOME"
  cat <<EOF

${INDIGO}marketharness first run${RESET} (OpenCode V1 $OPENCODE_PIN, isolated)

${BOLD}Next steps${RESET}
  1. Scaffold a workspace (skip if you were given one):
       ${BOLD}marketharness init-workspace ~/workspaces/<name> --company <slug> --project <slug>${RESET}
  2. Open it (workspace or project dir):
       ${BOLD}marketharness ~/workspaces/<name>/companies/<slug>/projects/<slug>${RESET}
  3. Run the onboarding command inside the TUI:
       ${BOLD}/marketharness-init${RESET}
     workspace -> company -> project -> model -> optional Qloo -> optional social -> first brief.
  4. Pick an available model when asked (${BOLD}marketharness models${RESET}). If no usable model
     is available, the onboarding flow offers provider setup — your existing
     OpenCode credentials are NEVER read; any import would be copy-only and
     explicit.

${MUTED}Your OpenCode install (~/.config/opencode, ~/.local/share/opencode) is never
touched: this launcher only uses its own runtime and XDG dirs.${RESET}

EOF
  touch "$marker"
}

# --- Help / version ---------------------------------------------------------
usage() {
  cat <<EOF
${INDIGO}marketharness${RESET} — marketing-team distribution of OpenCode V1 $OPENCODE_PIN (isolated)

${BOLD}Usage${RESET}
  marketharness [dir]           open the V1 TUI; an existing directory as the
                               first argument opens that workspace/project dir
                               (the session runs with the dir as cwd)
  marketharness init-workspace <dir> [--company slug] [--project slug]
                               scaffold the workspace tree (SPEC §5)
  marketharness update          re-run the installer in --update mode (source
                               re-copy or git fast-forward; edited staged config
                               is backed up first as <file>.bak.<timestamp>)
  marketharness help            show this help
  marketharness --version       product version, runtime pin, config paths,
                               qloo state, engram/aven state
  marketharness --stage-only    force re-render of the profile config

${BOLD}Team${RESET}
  marketing-lead (primary, default) -> research / growth / community,
  plus the audience-researcher subagent (Qloo-backed specialist)

${BOLD}Commands (in the TUI)${RESET}
  /marketharness-init  /marketharness-brief  /marketharness-research
  /marketharness-experiment  /marketharness-publish  /marketharness-report
  First run: start with ${BOLD}/marketharness-init${RESET}.

${BOLD}OpenCode V1 flags and subcommands (passed through)${RESET}
  -c/--continue  -s/--session  -m/--model  --agent  --prompt
  agent list, models, debug config, debug skill, run, serve, session, auth,
  stats, export, ... are forwarded to the pinned runtime unchanged. Any
  argument marketharness does not recognize is passed through verbatim.

${MUTED}Config home : $MARKETHARNESS_HOME   (XDG_CONFIG_HOME; rendered profile lives in $CONFIG_DIR)
Install root : $MARKETHARNESS_ROOT   (pinned runtime + installed repo)
Runtime      : $RUNTIME_BIN
Optional     : engram $(engram_state)
             : aven   $(aven_state)
Your existing OpenCode install (~/.config/opencode, ~/.local/share/opencode,
the opencode command) is never read or written; a pre-existing engram/aven on
your PATH is never used (product-private copies in $TOOLS_BIN take precedence).${RESET}
EOF
}

version_block() {
  local installed="not installed"
  if [[ -x "$RUNTIME_BIN" ]]; then
    installed="$("$RUNTIME_BIN" --version 2>/dev/null || printf 'unknown')"
  fi
  printf '%smarketharness%s %s\n' "$INDIGO" "$RESET" "$PRODUCT_VERSION"
  printf '%sprofile:%s  marketing-team distribution of OpenCode V1 (marketing-lead + research/growth/community + audience-researcher)\n' "$MUTED" "$RESET"
  printf '%spinned:%s  opencode-ai@%s (installed runtime: %s)\n' "$MUTED" "$RESET" "$OPENCODE_PIN" "$installed"
  printf '%sroot:%s    %s\n' "$MUTED" "$RESET" "$MARKETHARNESS_ROOT"
  printf '%shome:%s    %s\n' "$MUTED" "$RESET" "$MARKETHARNESS_HOME"
  printf '%sconfig:%s  %s\n' "$MUTED" "$RESET" "$OPENCODE_CONFIG"
  printf '%sskills:%s  %s/skills\n' "$MUTED" "$RESET" "$SKILLS_ROOT"
  printf '%sqloo:%s    %s\n' "$MUTED" "$RESET" "$(qloo_state)"
  printf '%sengram:%s  %s\n' "$MUTED" "$RESET" "$(engram_state)"
  printf '%saven:%s    %s\n' "$MUTED" "$RESET" "$(aven_state)"
  printf '%stools:%s   %s\n' "$MUTED" "$RESET" "$TOOLS_BIN"
}

# --- Wrapper-level commands (BEFORE staging/exec) ---------------------------
case "${1:-}" in
  help|--help|-h)
    usage
    exit 0
    ;;
  --version|version)
    version_block
    exit 0
    ;;
  --stage-only)
    STAGE_FIRST=0
    stage_profile 1
    printf 'staged profile -> %s (qloo: %s; engram: %s)\n' \
      "$CONFIG_DIR" "$(qloo_state)" "$(engram_state)"
    exit 0
    ;;
  init-workspace)
    shift
    exec python3 "$REPO_ROOT/bin/init-workspace" "$@"
    ;;
  update)
    if [[ ! -f "$REPO_ROOT/install.sh" ]]; then
      die "no installer at $REPO_ROOT/install.sh — re-install: bash <repo>/install.sh"
    fi
    exec bash "$REPO_ROOT/install.sh" --update
    ;;
esac

# --- Stage the profile on launch (first run + when source is newer) ---------
STAGE_FIRST=0
stage_profile 0

# --- Optional positional dir: open that workspace/project --------------------
if [[ $# -gt 0 && -d "$1" ]]; then
  cd "$1" || die "cannot cd into $1"
  shift
elif [[ $# -gt 0 && "$1" == -* ]]; then
  : # V1 flag -> passthrough
elif [[ $# -gt 0 && ( "$1" == /* || "$1" == ./* || "$1" == ../* ) && ! -d "$1" ]]; then
  die "$1 is not an existing directory (pass an existing workspace/project dir)"
fi

# --- Hermetic environment (SPEC §1) ----------------------------------------
export MARKETHARNESS_HOME
export MARKETHARNESS_ROOT
# aven's DB (SPEC §7b): pinned to the caller's REAL state home, captured before
# this XDG redirect. The hermetic state dir must never own the task board.
export AVEN_DB
export XDG_CONFIG_HOME="$MARKETHARNESS_HOME"
export XDG_DATA_HOME="$MARKETHARNESS_HOME/data"
export XDG_STATE_HOME="$MARKETHARNESS_HOME/state"
export XDG_CACHE_HOME="$MARKETHARNESS_HOME/cache"
export OPENCODE_CONFIG="$OPENCODE_CONFIG"
# Defensive: a globally exported OPENCODE_CONFIG_DIR would load additional
# config sources — isolation comes from the XDG redirect + OPENCODE_CONFIG.
unset OPENCODE_CONFIG_DIR
mkdir -p "$XDG_DATA_HOME" "$XDG_STATE_HOME" "$XDG_CACHE_HOME"

# Server-style Qloo auth (SPEC §7): the canonical mcp.qloo entry carries NO key,
# so when QLOO_API_KEY is present it must reach the MCP child — a stdio MCP
# server inherits this process's environment. When it is absent, the harness's
# own private configuration (`qloo setup --qloo`) is the credential, and no
# environment is needed.
if [[ -n "${QLOO_API_KEY:-}" ]]; then
  export QLOO_API_KEY
fi

# Hermetic skill set: V1 auto-scans ~/.claude/skills and ~/.agents/skills for
# "external" skills. A distribution session must only see its OWN skills
# (rendered skills.paths) plus built-ins, so that scan is disabled by default
# on the pinned tag (flag documented by opencode 1.19.3 itself); users who
# want their global external skills back can export 0.
export OPENCODE_DISABLE_EXTERNAL_SKILLS="${OPENCODE_DISABLE_EXTERNAL_SKILLS:-1}"

# --- Exec the isolated pinned runtime (NEVER a system opencode) -------------
if [[ ! -x "$RUNTIME_BIN" ]]; then
  printf '%smarketharness:%s OpenCode V1 runtime not found at %s\n' "$RED" "$RESET" "$RUNTIME_BIN" >&2
  printf '%smarketharness ships its own pinned runtime (opencode-ai@%s) and never uses a system opencode.%s\n' "$MUTED" "$OPENCODE_PIN" "$RESET" >&2
  printf '%sRun ./install.sh to install it (from the repo: bash <repo>/install.sh).%s\n' "$MUTED" "$RESET" >&2
  exit 127
fi
[[ -f "$OPENCODE_CONFIG" ]] \
  || die "no rendered profile config at $OPENCODE_CONFIG — re-run ./install.sh (or marketharness --stage-only)"

# Observed on the pinned tag: beside the hermetic config, the runtime probes
# the legacy ~/.opencode/opencode.json(c) path. Warn when such a file exists —
# it WOULD be merged into the session (isolation caveat, documented in README).
for legacy_cfg in "$HOME/.opencode/opencode.json" "$HOME/.opencode/opencode.jsonc"; do
  if [[ -f "$legacy_cfg" ]]; then
    printf '%smarketharness: warning:%s legacy config %s exists — the pinned runtime\nprobes it at boot and would merge it into this session. Move it aside for a\nfully hermetic marketharness session (your file is never modified here).\n' \
      "$RED" "$RESET" "$legacy_cfg" >&2
    break
  fi
done

# First interactive launch only (plain `marketharness [dir]`, not passthrough).
if [[ $# -eq 0 ]]; then
  maybe_first_launch_banner
fi

exec "$RUNTIME_BIN" "$@"
