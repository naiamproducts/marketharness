#!/usr/bin/env python3
"""init-workspace — scaffold the marketharness workspace tree (SPEC §5).

Renders files from workspace-template/ into a target directory with
{{workspace_id}} / {{company}} / {{project}} substitution.

Idempotent: existing files are kept (printed as `kept`) unless --force
overwrites them (printed as `created`). Empty deliverable dirs are always
ensured, with a .gitkeep so the tree survives git.

After scaffolding it binds the workspace to the optional local tools
(SPEC §7b), fail-soft:
  - `git init` (aven routes tasks by project boundary; engram falls back to it)
  - .engram/config.json {"project_name": "<workspace-slug>"}
  - the workspace path as an aven project (never a throwaway DB: aven inherits
    the caller's AVEN_DB / real state; this script never sets AVEN_DB)

Stdlib only. Exit codes: 0 ok, 1 error.
"""
import argparse
import json
import os
import re
import shutil
import subprocess
import sys

TEMPLATE_ROOT = os.path.join(
    os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "workspace-template"
)

# Template dir (relative to TEMPLATE_ROOT) -> target dir inside workspace.
# company/ renders into companies/<company>/, project/ into its project dir.
MAPPING = [
    ("workspace.yaml", ""),           # file at workspace root
    ("company", "companies/{company}"),
    ("project", "companies/{company}/projects/{project}"),
]

# Empty deliverable dirs per SPEC §5, created with .gitkeep.
PROJECT_EMPTY_DIRS = ["research", "strategy", "experiments", "campaigns", "reports"]

SLUG_RE = re.compile(r"^[a-z0-9][a-z0-9_-]*$")


def parse_args(argv=None):
    p = argparse.ArgumentParser(
        prog="init-workspace",
        description="Scaffold the marketharness workspace tree (SPEC §5) from "
                    "workspace-template/.",
        epilog="Example: init-workspace ~/workspaces/acme-ws "
               "--company acme --project launch_q3",
    )
    p.add_argument("dir", help="Target directory (created if missing)")
    p.add_argument("--company", default="example_company",
                   help="Company slug (snake_case); default: %(default)s")
    p.add_argument("--project", default="example_project",
                   help="Project slug (snake_case); default: %(default)s")
    p.add_argument("--workspace-id", default=None,
                   help="Workspace id; default: target directory basename")
    p.add_argument("--force", action="store_true",
                   help="Overwrite existing files (default: keep them)")
    return p.parse_args(argv)


def die(msg):
    print(f"error: {msg}", file=sys.stderr)
    sys.exit(1)


def render(text, subs):
    for key, value in subs.items():
        text = text.replace("{{%s}}" % key, value)
    return text


def scaffold_file(src, dst, subs, force):
    """Render src -> dst. Returns 'created' or 'kept'."""
    if os.path.exists(dst) and not force:
        return "kept"
    os.makedirs(os.path.dirname(dst), exist_ok=True)
    with open(src, encoding="utf-8") as f:
        content = render(f.read(), subs)
    with open(dst, "w", encoding="utf-8") as f:
        f.write(content)
    return "created"


def scaffold_tree(src_dir, dst_dir, subs, force, report):
    for entry in sorted(os.listdir(src_dir)):
        src = os.path.join(src_dir, entry)
        rel_entry = render(entry, subs)
        dst = os.path.join(dst_dir, rel_entry)
        if os.path.isdir(src):
            os.makedirs(dst, exist_ok=True)
            scaffold_tree(src, dst, subs, force, report)
        else:
            report.append((os.path.relpath(dst, subs["_root"]),
                           scaffold_file(src, dst, subs, force)))


# --- Optional local integrations (SPEC §7b) ---------------------------------
def run_tool(cmd, cwd=None, timeout=60):
    """Run a tool, never raise. Returns CompletedProcess or None."""
    try:
        return subprocess.run(cmd, cwd=cwd, capture_output=True, text=True,
                              timeout=timeout)
    except (OSError, subprocess.SubprocessError):
        return None


def aven_default_workspace(aven, cwd):
    """Read workspace.default from `aven config show` (no config get key)."""
    proc = run_tool([aven, "config", "show"], cwd=cwd)
    if not proc or proc.returncode != 0:
        return None
    in_workspace = False
    for line in proc.stdout.splitlines():
        if line.startswith("workspace:"):
            in_workspace = True
            continue
        if in_workspace:
            match = re.match(r"\s+default:\s*(\S+)", line)
            if match:
                return match.group(1)
            if line and not line[0].isspace():
                break
    return None


def bind_git(root):
    if os.path.exists(os.path.join(root, ".git")):
        return "git repo already present"
    if not shutil.which("git"):
        return "git NOT found — workspace is not a git repo; aven may not infer this project (install git, then: git -C %s init)" % root
    proc = run_tool(["git", "init", "-q", root])
    if proc and proc.returncode == 0:
        return "git repo initialized"
    return "git init FAILED — aven may not infer this project (run: git -C %s init)" % root


def bind_engram(root, workspace_id, force):
    """Pin the engram project name: without it, cwd detection can walk up."""
    cfg_dir = os.path.join(root, ".engram")
    cfg_path = os.path.join(cfg_dir, "config.json")
    if os.path.exists(cfg_path) and not force:
        return "engram project kept (.engram/config.json)"
    os.makedirs(cfg_dir, exist_ok=True)
    with open(cfg_path, "w", encoding="utf-8") as f:
        json.dump({"project_name": workspace_id}, f, indent=2)
        f.write("\n")
    return "engram project bound: %s (.engram/config.json)" % workspace_id


def bind_aven(root, workspace_id):
    aven = shutil.which("aven")
    if not aven:
        return ("aven not found (optional) — project not registered. "
                "Install it with the marketharness installer, then re-run: "
                "aven project create %s --path %s" % (workspace_id, root))
    create = [aven, "project", "create", workspace_id, "--path", root]
    proc = run_tool(create, cwd=root)
    # A fresh aven DB has no workspace matching the configured default; aven
    # itself hints at the fix, so do exactly that once and retry.
    if proc and proc.returncode != 0 and "unknown-workspace" in (proc.stderr or ""):
        default = aven_default_workspace(aven, root)
        if default:
            run_tool([aven, "workspace", "create", default], cwd=root)
            proc = run_tool(create, cwd=root)
    if proc and proc.returncode == 0:
        line = (proc.stdout or "").strip().splitlines()
        detail = line[0] if line else "registered"
        # Delegation labels must exist or `aven add --label <workstream>`
        # fails with "unknown-label". aven's label create is idempotent.
        created, failed = [], []
        for label in ("research", "growth", "community", "review"):
            lp = run_tool([aven, "label", "create", label], cwd=root)
            if lp and lp.returncode == 0:
                created.append(label)
            else:
                failed.append(label)
        if failed:
            return ("aven project ready: %s (labels NOT created: %s — run: aven label create <name>)"
                    % (detail, ", ".join(failed)))
        return "aven project ready: %s (labels: %s)" % (detail, ", ".join(created))
    err = ((proc.stderr or proc.stdout) if proc else "").strip().splitlines()
    return ("aven project NOT registered — %s\n     register manually: "
            "aven project create %s --path %s"
            % (err[-1] if err else "aven failed", workspace_id, root))



def main(argv=None):
    args = parse_args(argv)

    if not SLUG_RE.match(args.company):
        die(f"--company '{args.company}' is not a snake_case slug "
            "(lowercase letters, digits, _ or -)")
    if not SLUG_RE.match(args.project):
        die(f"--project '{args.project}' is not a snake_case slug "
            "(lowercase letters, digits, _ or -)")
    if not os.path.isdir(TEMPLATE_ROOT):
        die(f"template root not found: {TEMPLATE_ROOT}")

    root = os.path.abspath(args.dir)
    workspace_id = args.workspace_id or os.path.basename(root)
    if not SLUG_RE.match(workspace_id):
        die(f"workspace id '{workspace_id}' (from --workspace-id or directory "
            "name) is not a snake_case slug; pass --workspace-id")

    subs = {"workspace_id": workspace_id, "company": args.company,
            "project": args.project, "_root": root}

    os.makedirs(root, exist_ok=True)
    report = []
    for src_rel, dst_rel in MAPPING:
        src = os.path.join(TEMPLATE_ROOT, src_rel)
        if not os.path.exists(src):
            die(f"template entry missing: {src}")
        dst_dir = os.path.join(root, dst_rel.format(**subs)) if dst_rel else root
        if os.path.isdir(src):
            os.makedirs(dst_dir, exist_ok=True)
            scaffold_tree(src, dst_dir, subs, args.force, report)
        else:
            dst = os.path.join(dst_dir, render(os.path.basename(src), subs))
            rel = os.path.relpath(dst, root)
            report.append((rel, scaffold_file(src, dst, subs, args.force)))

    # Empty deliverable dirs (SPEC §5) with .gitkeep so git keeps them.
    project_dir = os.path.join(
        root, "companies", args.company, "projects", args.project)
    for d in PROJECT_EMPTY_DIRS:
        full = os.path.join(project_dir, d)
        os.makedirs(full, exist_ok=True)
        keep = os.path.join(full, ".gitkeep")
        if not os.path.exists(keep):
            with open(keep, "w", encoding="utf-8") as f:
                f.write("")
            report.append((os.path.relpath(keep, root), "created"))

    created = kept = 0
    for rel, action in report:
        print(f"{action:<7} {rel}")
        if action == "created":
            created += 1
        else:
            kept += 1
    print(f"done: {created} created, {kept} kept — workspace at {root}")

    # Optional local integrations (SPEC §7b) — fail-soft, never blocking.
    engram_note = bind_engram(root, workspace_id, args.force)
    git_note = bind_git(root)
    aven_note = bind_aven(root, workspace_id)
    print()
    print("Integrations (optional):")
    print(f"  git     {git_note}")
    print(f"  engram  {engram_note}")
    print(f"  aven    {aven_note}")

    print()
    print("Next steps:")
    print(f"  1. Fill in company display name: companies/{args.company}/company.yaml")
    print(f"  2. Fill in brand/identity.md and brand/voice.md, and the policies "
          f"if the starter rules don't fit.")
    print(f"  3. Open the project with: marketharness "
          f"{os.path.join(root, 'companies', args.company, 'projects', args.project)}")
    print(f"  4. Run the first-run onboarding command: marketharness-init")
    print(f"  5. Delegations become aven tasks; inspect them with: aven list")
    print(f"     Decisions are saved to engram under marketharness/{workspace_id}/<area>.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
